{
  "schemaVersion": 1,
  "id": "hybrid_birds",
  "version": "${version}",
  "name": "Hybrid Birds",
  "description": "${description}",
  "authors": [
    "Hybrid Labs"
  ],
  "contact": {
    "homepage": "https://hybridlabs.net/",
    "sources": "https://github.com/hybridlabs/hybrid-birds",
    "issues": "https://github.com/hybridlabs/hybrid-birds/issues"
  },
  "license": "ARR",
  "icon": "assets/hybrid_birds/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "dev.hybridlabs.skies.HybridSkies",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "dev.hybridlabs.skies.HybridSkiesClient",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "dev.hybridlabs.skies.data.HSDataGenerator",
        "adapter": "kotlin"
      }
    ],
    "preLaunch": [
      "com.llamalad7.mixinextras.MixinExtrasBootstrap::init"
    ]
  },
  "mixins": [
    "hybrid_birds.fabric.mixins.json"
  ],
  "accessWidener": "hybrid_birds.accesswidener",
  "depends": {
    "fabricloader": ">=0.19",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-language-kotlin": "*",
    "fabric-api": ">=0.141",
    "geckolib": ">=5.4.5",
    "hapi": ">=1.3.0"
  }
}
